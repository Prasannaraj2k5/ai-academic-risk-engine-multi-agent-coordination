# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=2

# Primary Database (PostgreSQL 15)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_risk_db
SQLITE_FALLBACK_URL=sqlite:///./academic_risk.db

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
